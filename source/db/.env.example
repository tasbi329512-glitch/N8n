# ============================================================
# Flowmint — database configuration EXAMPLE
# Copy to .env (or your host's env settings) and fill in.
# NEVER commit real secrets. No real values are stored here.
# ============================================================

# --- Connection (example values are placeholders, not real) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=n8nclone
DB_USER=n8nclone_app
DB_PASSWORD=CHANGE_ME__use_a_password_manager_or_vault

# Read-only website backend role (public content only, see migration 006)
DB_ANON_USER=n8nclone_anon
DB_ANON_PASSWORD=CHANGE_ME__separate_credential

# CMS admin role — server-side only, never exposed to the browser
DB_ADMIN_USER=n8nclone_admin
DB_ADMIN_PASSWORD=CHANGE_ME__separate_credential

# --- App auth ---
# Secret used to sign CMS session tokens. Generate with:
#   openssl rand -base64 48
SESSION_SIGNING_KEY=CHANGE_ME__generated_value_min_32_bytes
SESSION_TTL_MINUTES=60

# HMAC key used to hash client IPs before storage (ip_hash).
# Rotate via a new key id; old hashes are one-way and stay valid.
IP_HMAC_KEY=CHANGE_ME__generated_value_min_32_bytes

# --- Data retention (see reports/agent03-database.md § Security) ---
# Form submissions are auto-purged after this many days.
FORM_RETENTION_DAYS=365

# --- Deployment note ---
# The shipped marketing site is STATIC (data/*.json). This database
# backs an OPTIONAL CMS/backend phase only. Leave these unset for
# the static deploy; nothing in the static build reads them.
DB_ENABLED=false
