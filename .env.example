# ============================================================
# Flowmint — runtime / deployment configuration EXAMPLE
# Copy to `.env` (or set in your host's environment settings) and
# fill in real values. NEVER commit real secrets to git.
# No real values are stored in this file — all values below are
# placeholders or safe defaults.
# ============================================================

# --- Node lead-capture API server (api/server.js) ---
# The marketing site is fully static. This server is OPTIONAL:
# it serves source/ and powers POST /api/forms (lead capture).
# Without it, the static site still works; forms show an honest
# "could not reach our server" message instead of fake success.
PORT=3000

# --- Optional PostgreSQL phase (CMS/backend) ---
# The current server.js stores submissions in an append-only JSONL
# store under api/data/ and does NOT read these variables yet.
# They apply to the future backend phase: run the migrations in
# source/db/migrations/ (001..006) against PostgreSQL 15+ first.
# Full per-role examples live in source/db/.env.example.
DB_ENABLED=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flowmint
DB_USER=flowmint_app
DB_PASSWORD=CHANGE_ME__use_a_password_manager_or_vault

# HMAC key used to hash client IPs before storage (ip_hash column).
# Generate with: openssl rand -hex 32
IP_HMAC_KEY=CHANGE_ME__generated_value_min_32_bytes

# Form submissions auto-purge after this many days (data retention).
FORM_RETENTION_DAYS=365

# --- Production URL (used by sitemap.xml / robots.txt at launch) ---
# Replace with the real deployed domain before launch.
SITE_URL=https://example.com
